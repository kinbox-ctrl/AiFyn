{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aifyn",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aifyn-db",
      "database_id": "da0d3ae2-d306-48b9-a3f0-296816172d5d",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "aifyn.in", "custom_domain": true },
    { "pattern": "www.aifyn.in", "custom_domain": true }
  ],
  // EmailJS (https://dashboard.emailjs.com): service connected to hello@aifyn.in, plus the two template IDs.
  // Secrets (not committed): `npx wrangler secret put ADMIN_PASSWORD` and `npx wrangler secret put EMAILJS_PRIVATE_KEY`.
  "vars": {
    "CONTACT_EMAIL": "hello@aifyn.in",
    "EMAILJS_SERVICE_ID": "service_fvhqb85",
    "EMAILJS_PUBLIC_KEY": "8HS0dTVd8MrDboxNg",
    "EMAILJS_TEMPLATE_THANKS": "template_mli80zb",
    "EMAILJS_TEMPLATE_LEAD": "template_n8spmd8"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
